<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gym_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Crear Rutina"
        android:textColor="@color/gym_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <!-- Campo nombre de rutina -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="@color/gym_primary"
        app:hintTextColor="@color/gym_primary"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNombreRutina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la rutina"
            android:inputType="text"
            android:textColor="@color/gym_text_primary"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Selector día de la semana -->
    <LinearLayout
        android:id="@+id/llDiasSemana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <CheckBox
            android:id="@+id/cbLunes"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="L"
            android:textSize="14sp"
            android:textColor="@color/gym_text_primary"
            android:button="@null"
            android:background="@drawable/bg_dia_semana_selector"
            android:gravity="center"
            android:layout_margin="2dp"/>

        <CheckBox
            android:id="@+id/cbMartes"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="M"
            android:textSize="14sp"
            android:textColor="@color/gym_text_primary"
            android:button="@null"
            android:background="@drawable/bg_dia_semana_selector"
            android:gravity="center"
            android:layout_margin="2dp"/>

        <CheckBox
            android:id="@+id/cbMiercoles"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="X"
            android:textSize="14sp"
            android:textColor="@color/gym_text_primary"
            android:button="@null"
            android:background="@drawable/bg_dia_semana_selector"
            android:gravity="center"
            android:layout_margin="2dp"/>

        <CheckBox
            android:id="@+id/cbJueves"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="J"
            android:textSize="14sp"
            android:textColor="@color/gym_text_primary"
            android:button="@null"
            android:background="@drawable/bg_dia_semana_selector"
            android:gravity="center"
            android:layout_margin="2dp"/>

        <CheckBox
            android:id="@+id/cbViernes"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="V"
            android:textSize="14sp"
            android:textColor="@color/gym_text_primary"
            android:button="@null"
            android:background="@drawable/bg_dia_semana_selector"
            android:gravity="center"
            android:layout_margin="2dp"/>

        <CheckBox
            android:id="@+id/cbSabado"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="S"
            android:textSize="14sp"
            android:textColor="@color/gym_text_primary"
            android:button="@null"
            android:background="@drawable/bg_dia_semana_selector"
            android:gravity="center"
            android:layout_margin="2dp"/>

        <CheckBox
            android:id="@+id/cbDomingo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="D"
            android:textSize="14sp"
            android:textColor="@color/gym_text_primary"
            android:button="@null"
            android:background="@drawable/bg_dia_semana_selector"
            android:gravity="center"
            android:layout_margin="2dp"/>

    </LinearLayout>

    <!-- Botón agregar ejercicio -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAgregarEjercicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_secondary"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:text="+ Agregar Ejercicio"
        android:textColor="@color/gym_primary"
        android:textSize="14sp"/>

    <!-- Lista de ejercicios -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEjercicios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

    <!-- Botón guardar -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGuardarRutina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_primary"
        android:layout_marginTop="16dp"
        android:padding="14dp"
        android:text="Guardar Rutina"
        android:textColor="@color/white"
        android:textSize="14sp"/>

</LinearLayout>