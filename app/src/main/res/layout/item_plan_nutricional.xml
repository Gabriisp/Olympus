<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Indicador lateral -->
    <View
        android:layout_width="4dp"
        android:layout_height="50dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_button_primary"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombrePlanItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plan Nutricional"
            android:textColor="@color/gym_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvDescripcionPlanItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Descripción del plan"
            android:textColor="@color/gym_text_secondary"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tvNumComidasItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0/4 comidas"
            android:textColor="@color/gym_cyan"
            android:textSize="12sp"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMenuPlanNutricionista"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_more"
        android:tint="@color/gym_text_secondary"
        android:contentDescription="Opciones"/>
</LinearLayout>