<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/gym_card_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombrePlanItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plan Nutricional"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDescripcionPlanItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción del plan"
                android:textColor="@color/gym_text_gray"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvNumComidasItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/4 comidas"
                android:textColor="@color/gym_blue"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMenuPlanNutricionista"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            android:tint="@color/white"
            android:contentDescription="Opciones"/>
    </LinearLayout>

</androidx.cardview.widget.CardView>
