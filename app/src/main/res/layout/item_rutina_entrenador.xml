<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/gym_card_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreRutinaEntrenador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rutina de Pecho"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvNumEjercicios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 ejercicios"
                android:textColor="@color/gym_text_gray"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMenuRutinaEntrenador"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            android:tint="@color/white"
            android:contentDescription="Opciones"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
