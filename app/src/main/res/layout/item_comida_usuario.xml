<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Franja separadora -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gym_button_dark"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvTipoComidaUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌅 Desayuno"
        android:textColor="@color/gym_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivComidaUsuarioImagen"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreComidaUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avena con Frutas"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDescComidaUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textColor="@color/gym_text_gray"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvCaloriasComidaUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="320 kcal"
                android:textColor="@color/gym_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Texto cuando no hay comida -->
    <TextView
        android:id="@+id/tvComidaVaciaUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sin comida asignada"
        android:textColor="@color/gym_text_gray"
        android:textSize="13sp"
        android:fontFamily="sans-serif-light"
        android:visibility="gone"/>

</LinearLayout>
