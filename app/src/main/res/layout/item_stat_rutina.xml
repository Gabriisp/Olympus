<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvRoutineStatName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rutina"
        android:textColor="@color/gym_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRoutineStatSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Resumen"
        android:textColor="@color/gym_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvRoutineStatHighlights"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Highlights"
        android:textColor="@color/gym_text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvRoutineStatAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Ver rendimiento por ejercicio"
        android:textColor="@color/gym_primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>