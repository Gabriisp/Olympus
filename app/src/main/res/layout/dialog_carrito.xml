<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/gym_card_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resumen del Carrito"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvResumenCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gym_text_gray"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            android:maxHeight="200dp"
            android:scrollbars="vertical"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total:"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTotalResumen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00€"
                android:textColor="@color/gym_blue"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnIrCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IR AL CARRITO"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_blue_gradient"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnCerrarDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_blue_gradient"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>