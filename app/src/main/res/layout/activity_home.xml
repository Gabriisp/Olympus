<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gym_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olympus GYM"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@drawable/ic_launcher_foreground"
            app:drawableTint="@color/gym_blue"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registra tus entrenamientos"
            android:textColor="@color/gym_text_gray"
            android:layout_marginTop="4dp"/>

        <Space android:layout_width="match_parent" android:layout_height="24dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi Gimnasio"
                android:backgroundTint="#0F172A"
                android:textColor="@color/white"/>

            <Space android:layout_width="12dp" android:layout_height="match_parent"/>

            <Button
                android:id="@+id/btnTienda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tienda"
                android:backgroundTint="@color/white"
                android:textColor="@color/black"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="24dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/gym_surface_white"
            android:padding="12dp"
            android:orientation="horizontal"
            android:weightSum="5">

            <TextView
                android:id="@+id/tvRutinas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rutinas"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/tvEjercicios"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ejercicios"
                android:gravity="center"
                android:textColor="@color/black"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/tvGyms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gyms"
                android:gravity="center"
                android:textColor="@color/black"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/tvNotas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notas"
                android:gravity="center"
                android:textColor="@color/black"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stats"
                android:gravity="center"
                android:textColor="@color/black"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"/>

        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="24dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:cardBackgroundColor="#1E2638"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvRutinasTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mis Rutinas"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nueva Rutina"
                    android:layout_alignParentEnd="true"
                    android:backgroundTint="@color/gym_blue"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="No hay rutinas creadas"
                    android:textColor="@color/gym_text_gray"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>